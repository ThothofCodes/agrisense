# AgriSense Smart Farming System
# See https://git-scm.com/docs/gitignore for reference.

# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ── Build outputs ─────────────────────────────────────────────────────────────
dist/
build/
*.tsbuildinfo
.next/

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
*.joblib
*.pkl
*.bin
.pytest_cache/

# ── Environment — NEVER commit secrets ────────────────────────────────────────
.env
.env.local
.env.production
.env.staging
!.env.example

# ── Logs ──────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*

# ── Docker volumes ────────────────────────────────────────────────────────────
postgres_data/
redis_data/

# ── IDE / Editor ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.DS_Store?

# ── Coverage / Reports ────────────────────────────────────────────────────────
coverage/
.nyc_output/
htmlcov/
*.lcov

# ── Mosquitto runtime ─────────────────────────────────────────────────────────
infrastructure/mosquitto/data/
infrastructure/mosquitto/log/

# ── SSL certs (manage separately, outside version control) ───────────────────
infrastructure/nginx/certs/

# ── ML model artifacts (managed via model registry, not git) ─────────────────
apps/ml/models/*.joblib
apps/ml/models/*.pkl
apps/ml/models/*.bin

# ── Git hooks (generated by husky) ────────────────────────────────────────────
.husky/_

# ── Generated documentation ───────────────────────────────────────────────────
CHANGELOG.md

# ── Misc ──────────────────────────────────────────────────────────────────────
*.retry
*.bak
*.orig
.tmp/
tmp/
