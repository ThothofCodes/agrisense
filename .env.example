# ── AgriSense Environment Variables ──────────────────────────────────────────
# Copy to .env and fill in values before running

# ── Node / App ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
API_BASE_URL=http://localhost:3001

# ── Database (PostgreSQL + TimescaleDB) ───────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agrisense
DB_USER=agrisense
DB_PASSWORD=agrisense_secret
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=10

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ── JWT Auth ──────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=your_access_secret_min_64_chars_here_change_in_production
JWT_REFRESH_SECRET=your_refresh_secret_min_64_chars_here_change_in_production
JWT_ACCESS_EXPIRES=24h
JWT_REFRESH_EXPIRES=7d

# ── MQTT (Mosquitto) ──────────────────────────────────────────────────────────
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=agrisense
MQTT_PASSWORD=mqtt_secret
MQTT_CLIENT_ID=agrisense-api

# ── ML Service (Python FastAPI) ───────────────────────────────────────────────
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TIMEOUT=30000

# ── Weather APIs ──────────────────────────────────────────────────────────────
OPENWEATHER_API_KEY=your_openweathermap_api_key
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5
TOMORROW_IO_API_KEY=your_tomorrow_io_api_key
TOMORROW_IO_BASE_URL=https://api.tomorrow.io/v4
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/daily/point

# ── Africa's Talking (SMS / USSD) ─────────────────────────────────────────────
AT_API_KEY=your_africas_talking_api_key
AT_USERNAME=your_at_username
AT_SENDER_ID=AgriSense
AT_BASE_URL=https://api.africastalking.com/version1

# ── M-Pesa Daraja (Payments) ──────────────────────────────────────────────────
MPESA_CONSUMER_KEY=your_mpesa_consumer_key
MPESA_CONSUMER_SECRET=your_mpesa_consumer_secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your_mpesa_passkey
MPESA_CALLBACK_URL=https://yourdomain.com/api/payments/mpesa/callback
MPESA_ENV=sandbox

# ── Farmonaut (Satellite fallback) ────────────────────────────────────────────
FARMONAUT_API_KEY=your_farmonaut_api_key

# ── App Config ────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
IOT_RATE_LIMIT_MAX=60   # per device_id (node), not per IP — see routes/sensors.ts ingestionLimiter
AUTH_RATE_LIMIT_MAX=5
CORS_ORIGIN=http://localhost:5173

# ── Clerk Authentication ──────────────────────────────────────────────────────
# Create a Clerk app at https://dashboard.clerk.com and copy your keys:
# - Publishable Key (frontend, starts with pk_)
# - Secret Key (backend, starts with sk_)
# - Webhook Secret (for webhook verification, starts with whsec_)
#
# Social Login (Google, GitHub, Apple) — enables "Continue with Google/GitHub/Apple"
# buttons on the sign-in and sign-up pages. Configure in Clerk Dashboard:
#   User & Authentication → Social Login → Enable each provider → fill in OAuth keys
# See docs/clerk-oauth-setup.md for step-by-step instructions.
# Leave VITE_CLERK_PUBLISHABLE_KEY empty to fall back to legacy JWT auth.
VITE_CLERK_PUBLISHABLE_KEY=pk_your_publishable_key_here
CLERK_SECRET_KEY=sk_your_secret_key_here
CLERK_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# ── Frontend ──────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:3001/api/v1
VITE_WS_URL=ws://localhost:3001/ws
VITE_MAPBOX_TOKEN=your_mapbox_token_optional
